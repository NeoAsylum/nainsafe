PATH=/home/adria/.cargo/bin:/home/adria/.local/bin:/usr/local/bin:/usr/bin:/bin

# Haelt die VM wach. WSL2 faehrt sie herunter, wenn sie leer laeuft -- zwischen zwei
# Tageslaeufen, bei erreichtem Budget oder geschlossenem Sitzungsfenster stehen sonst nur
# systemd und cron. Am 2026-09-05 ist die VM zweimal verschwunden und hat die Fabrik
# mitgenommen. Kostet nichts: sleep infinity belegt keinen Kern.
@reboot /home/adria/fabrik/einrichtung/anker-prozess.sh

# Stuendlich statt einmal um 03:00. Grund: Am 2026-09-03 schlief der Windows-Wirt von
# 21:30 bis 15:00 durch, die WSL-VM war eingefroren, und cron holt nichts nach -- ein
# ganzer Fabriktag fiel lautlos aus. Ein stuendlicher Versuch ist der Nachholmechanismus:
# ops/tageslauf.sperre laesst nur einen zugleich zu, und ist das Tagesbudget erreicht,
# endet der Versuch nach null Durchgaengen ohne einen einzigen Agentenaufruf.
#
# `python3 -u`, weil Python seine Ausgabe sonst puffert: Das Protokoll blieb waehrend
# des ganzen Laufs leer und fuellte sich erst am Ende. Wer mitten im Lauf nachsieht, ob
# etwas geschieht, sah nichts -- und "niemand merkt, dass nichts passiert" war der
# eigentliche Fehler.
#
# Denselben Takt gibt es ein zweites Mal in der Windows-Aufgabenplanung
# (einrichtung/ANKER.md). Das ist Absicht: Dieser hier laeuft, solange die VM lebt, der
# andere weckt sie. Beide prallen an derselben Sperre ab.
0 * * * * cd /home/adria/fabrik && /usr/bin/python3 -u agents/tageslauf.py >> ops/nachtlauf.log 2>&1

# The translator resumes itself, like the factory. On 2026-09-07 the session limit
# stopped it at 12:03 and nobody restarted it until 15:13 -- three hours in which the
# factory had already resumed on its own at 15:00. Ten past the hour, so it never races
# the tageslauf start; flock -n so two invocations never overlap; it exits at once when
# ops/uebersetzt.txt says nothing is left.
10 * * * * cd /home/adria/fabrik && flock -n ops/uebersetzung.sperre /usr/bin/python3 -u agents/uebersetzungslauf.py --stueck 60 >> ops/uebersetzung.log 2>&1

0 7 * * 0 cd /home/adria/fabrik && /usr/bin/python3 -u agents/wochenlauf.py >> ops/wochenlauf.log 2>&1

# Sicherung ebenfalls nachholend; die Logik steht im Skript, nicht in dieser Zeile.
20 * * * * /home/adria/fabrik/einrichtung/sichern.sh >> /home/adria/fabrik/ops/backup.log 2>&1

*/30 * * * * cd /home/adria/fabrik && /usr/bin/python3 agents/dashboard.py > /dev/null 2>&1
