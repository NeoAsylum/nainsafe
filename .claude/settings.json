{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.credentials.json)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.pfx)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(~/.claude/**)",
      "Read(//**/AppData/Roaming/Microsoft/**)",
      "Read(//**/AppData/Local/Microsoft/Edge/**)",
      "Read(//**/AppData/Local/Google/Chrome/**)",
      "Read(//**/AppData/Roaming/Mozilla/**)",
      "Edit(//**/.git/**)",
      "Write(//**/.git/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["."]
    }
  }
}
